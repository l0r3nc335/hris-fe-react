# Leave empty for local dev (Vite proxies /api). Default target is NestJS :3000; use :3001 for BE_JAVA.
# VITE_DEV_PROXY_TARGET=http://localhost:3001
VITE_API_BASE_URL=
VITE_APP_ENV=development
VITE_SENTRY_DSN=

# Integration/e2e tests expect the NestJS API at VITE_API_BASE_URL with Docker Postgres on port 5433.
# Run from FE: npm run services:up && npm run be:dev
