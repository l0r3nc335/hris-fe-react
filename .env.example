# Leave empty for local dev (Vite proxies /api → localhost:3000). Set to http://localhost:3000 only for integration tests.
VITE_API_BASE_URL=
VITE_APP_ENV=development
VITE_SENTRY_DSN=

# Integration/e2e tests expect the NestJS API at VITE_API_BASE_URL with Docker Postgres on port 5433.
# Run from FE: npm run services:up && npm run be:dev
